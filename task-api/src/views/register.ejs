<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro · UNAS Tasks</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="landing-bg d-flex align-items-center justify-content-center">

  <div class="landing-card p-4">
    <div class="text-center mb-3">
      <h2 class="landing-title mb-1">Registro</h2>
      <p class="landing-subtitle mb-0">Crea tu cuenta para gestionar tareas</p>
    </div>

    <hr class="mb-4">

    <form id="registerForm" class="px-2">
      <div class="mb-3">
        <label class="label-green">Usuario</label>
        <input type="text" id="username" class="form-control" required>
      </div>
      <div class="mb-4">
        <label class="label-green">Contraseña</label>
        <input type="password" id="password" class="form-control" required>
      </div>
      <button type="submit" class="btn btn-green w-100">Registrarse</button>
    </form>

    <div id="msg" class="mt-3 text-center small"></div>

    <div class="text-center mt-2">
      <small class="footer-subtitle">
        ¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>
      </small>
    </div>
  </div>

  <script>
    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;

      const res = await fetch('/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });

      const data = await res.json();
      if (res.ok) {
        alert('Usuario creado. Por favor inicia sesión.');
        window.location.href = '/login';
      } else {
        const msg = document.getElementById('msg');
        msg.innerText = data.message || 'No se pudo registrar el usuario';
        msg.className = 'text-danger mt-3 text-center small';
      }
    });
  </script>

</body>
</html>

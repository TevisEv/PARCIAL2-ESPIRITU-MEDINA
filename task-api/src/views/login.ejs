<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Login - UNAS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
  <div class="card p-4 shadow" style="width: 350px;">
    <h3 class="text-center mb-3">Iniciar Sesión</h3>
    <form id="loginForm">
      <div class="mb-3"><input type="text" id="username" class="form-control" placeholder="Usuario" required></div>
      <div class="mb-3"><input type="password" id="password" class="form-control" placeholder="Contraseña" required></div>
      <button class="btn btn-primary w-100">Ingresar</button>
    </form>
    <div id="msg" class="text-danger mt-2 text-center"></div>
  </div>
  <script>
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const user = document.getElementById('username').value;
      const pass = document.getElementById('password').value;
      
      const res = await fetch('/auth/login', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ username: user, password: pass })
      });
      const data = await res.json();
      
      if(res.ok) {
        localStorage.setItem('token', data.token);
        localStorage.setItem('username', data.username);
        // Redirección por Rol
        if(data.role === 'admin') window.location.href = '/panel-admin';
        else if(data.role === 'docente') window.location.href = '/panel-docente';
        else window.location.href = '/panel-alumno';
      } else {
        document.getElementById('msg').innerText = data.message;
      }
    });
  </script>
</body>
</html>
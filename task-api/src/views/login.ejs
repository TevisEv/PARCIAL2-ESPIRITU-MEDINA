<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Iniciar sesión · UNAS Tasks</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="landing-bg d-flex align-items-center justify-content-center">

  <div class="landing-card p-4">
    <div class="text-center mb-3">
      <h2 class="landing-title mb-1">Iniciar sesión</h2>
      <p class="landing-subtitle mb-0">Accede a tu panel de tareas académicas</p>
    </div>

    <hr class="mb-4">

    <form id="loginForm" class="px-2">
      <div class="mb-3">
        <label class="label-green">Usuario</label>
        <input type="text" id="username" class="form-control" required>
      </div>
      <div class="mb-4">
        <label class="label-green">Contraseña</label>
        <input type="password" id="password" class="form-control" required>
      </div>
      <button class="btn btn-green w-100 mb-2">Ingresar</button>
    </form>

    <div id="msg" class="text-danger mt-2 text-center small"></div>

    <div class="text-center mt-3">
      <small class="footer-subtitle">
        ¿Aún no tienes cuenta? <a href="/register">Registrarte</a>
      </small>
    </div>
  </div>

<script>
document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();

  const user = document.getElementById('username').value.trim();
  const pass = document.getElementById('password').value.trim();

  const res = await fetch('/auth/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username: user, password: pass })
  });

  const data = await res.json();

  if (!res.ok) {
    document.getElementById('msg').innerText =
      data.message || "Credenciales inválidas";
    return;
  }

  // Guardar datos correctos
  localStorage.setItem('token', data.token);
  localStorage.setItem('username', data.username);
  localStorage.setItem('role', data.role);   // <-- FALTABA ESTO

  // Redirección por rol
  if (data.role === 'admin') {
    window.location.href = '/panel-admin';

  } else if (data.role === 'docente') {
    window.location.href = '/panel-docente';

  } else if (data.role === 'alumno') {
    window.location.href = '/panel-alumno';  // <-- ESTA VISTA ESTAMOS VIENDO
  }
});
</script>


</body>
</html>

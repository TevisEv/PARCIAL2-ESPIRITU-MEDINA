<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Administrador · UNAS Task Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-layout">

  <aside class="sidebar collapsed">
    <div class="sidebar-header">
      <div class="sidebar-logo">U</div>
      <div class="sidebar-title">Sistema de Tareas<br>UNAS</div>
    </div>
    <ul class="sidebar-menu">
      <li class="sidebar-item">
        <a href="/panel-admin" class="sidebar-link active">
          <span class="icon">⚙️</span><span>Administración</span>
        </a>
      </li>
    </ul>
  </aside>

  <div class="main-content">
    <div class="topbar">
      <button id="sidebarToggle" class="sidebar-toggle">☰</button>
      <div class="d-flex align-items-center gap-3">
        <span id="adminName" class="small fw-semibold">Admin</span>
        <button onclick="logout()" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
      </div>
    </div>

    <div class="main-inner">
      <h2 class="main-title"><span>Panel administrador</span></h2>

      <div class="card-3d mb-4">
        <div class="card-3d-header"><div class="card-3d-title">Gestión académica</div></div>
        <div class="card-3d-body">
          <div class="row g-3">
            
            <div class="col-lg-4">
              <div class="card-main p-3 h-100">
                <h5 class="title-primary mb-3">1. Crear grupo</h5>
                <input type="text" id="groupName" class="form-control mb-2" placeholder="Ej: Matemáticas">
                <button onclick="createGroup()" class="btn btn-green w-100">Crear grupo</button>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="card-main p-3 h-100">
                <h5 class="title-primary mb-3">2. Asignar docente</h5>
                <label class="label-green">Docente</label>
                <select id="assignTeacherSelect" class="form-select mb-2">
                    <option value="">Cargando...</option>
                </select>

                <label class="label-green">Grupo</label>
                <select id="assignGroupSelect" class="form-select mb-3">
                    <option value="">Cargando...</option>
                </select>

                <button onclick="assignTeacherToGroup()" class="btn btn-secondary-green w-100">Asignar responsabilidad</button>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="card-main p-3 h-100">
                <h5 class="title-primary mb-3">3. Registrar usuario</h5>
                <input type="text" id="newUser" class="form-control mb-2" placeholder="Usuario">
                <input type="password" id="newPass" class="form-control mb-2" placeholder="Contraseña">
                <div class="row g-2 mb-2">
                  <div class="col">
                    <select id="newRole" class="form-select" onchange="toggleGroupSelect()">
                      <option value="alumno">Alumno</option>
                      <option value="docente">Docente</option>
                      <option value="admin">Admin</option>
                    </select>
                  </div>
                  <div class="col">
                    <select id="userGroupSelect" class="form-select">
                      <option value="">Grupo (solo alumno)</option>
                    </select>
                  </div>
                </div>
                <button onclick="createUser()" class="btn btn-green w-100">Registrar</button>
              </div>
            </div>

          </div>
        </div>
      </div>

      <div class="card-3d">
        <div class="card-3d-header"><div class="card-3d-title">Lista de usuarios</div></div>
        <div class="card-3d-body" style="max-height: 350px; overflow-y: auto;">
          <ul id="userList" class="list-group list-group-flush">
             <li class="list-group-item text-muted">Cargando...</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // === CONFIGURACIÓN ===
  const token = localStorage.getItem('token');
  if (!token) window.location.href = '/login';
  
  const user = localStorage.getItem('username');
  if (user) document.getElementById('adminName').innerText = user;

  // === SIDEBAR ===
  document.getElementById('sidebarToggle').addEventListener('click', () => {
    document.querySelector('.sidebar').classList.toggle('collapsed');
    document.querySelector('.sidebar').classList.toggle('expanded');
    document.querySelector('.main-content').classList.toggle('shifted');
  });

  // === CARGA DE DATOS ===
  async function loadData() {
    try {
      const res = await fetch('/admin/dashboard-data', {
        headers: { 'Authorization': 'Bearer ' + token }
      });

      if (!res.ok) {
        if(res.status === 401) return logout();
        console.error("Error servidor:", res.status);
        return; 
      }

      const data = await res.json();
      console.log("Datos recibidos:", data); // Mira la consola para depurar

      // 1. SELECTS DE GRUPOS
      const groupSelects = [
        document.getElementById('assignGroupSelect'), 
        document.getElementById('userGroupSelect')
      ];
      
      const defaultGroupOption = '<option value="">-- Seleccione grupo --</option>';
      groupSelects.forEach(sel => sel.innerHTML = defaultGroupOption);

      if (data.groups && data.groups.length > 0) {
        data.groups.forEach(g => {
          const opt = `<option value="${g.id}">${g.name}</option>`;
          groupSelects.forEach(sel => sel.innerHTML += opt);
        });
      } else {
        groupSelects.forEach(sel => sel.innerHTML = '<option value="">(No hay grupos)</option>');
      }

      // 2. SELECT DE DOCENTES
      const teacherSelect = document.getElementById('assignTeacherSelect');
      teacherSelect.innerHTML = '<option value="">-- Seleccione docente --</option>';
      
      if (data.teachers && data.teachers.length > 0) {
        data.teachers.forEach(t => {
          teacherSelect.innerHTML += `<option value="${t.id}">${t.username}</option>`;
        });
      } else {
        teacherSelect.innerHTML = '<option value="">(No hay docentes)</option>';
      }

      // 3. LISTA DE USUARIOS
      const list = document.getElementById('userList');
      list.innerHTML = '';

      if (!data.users || data.users.length === 0) {
        list.innerHTML = '<li class="list-group-item text-muted">No hay usuarios registrados.</li>';
      } else {
        data.users.forEach(u => {
          let badgeClass = u.role === 'admin' ? 'bg-danger' : (u.role === 'docente' ? 'bg-warning text-dark' : 'bg-info');
          list.innerHTML += `
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span>
                <b>${u.username}</b>
                <span class="badge ${badgeClass} ms-2 text-uppercase">${u.role}</span>
              </span>
              <span class="text-muted small">${u.group_name || 'Sin grupo'}</span>
            </li>`;
        });
      }
      
      toggleGroupSelect();

    } catch (err) {
      console.error("Error JS:", err);
      alert("Error al cargar datos. Ver consola.");
    }
  }

  // === ACCIONES ===
  async function createUser() {
    const body = {
      username: document.getElementById('newUser').value,
      password: document.getElementById('newPass').value,
      role: document.getElementById('newRole').value,
      group_id: document.getElementById('userGroupSelect').value || null
    };

    if(!body.username || !body.password) return alert("Faltan datos");

    const res = await fetch('/admin/create-user', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify(body)
    });

    if(res.ok) {
        alert("Usuario creado");
        document.getElementById('newUser').value = '';
        document.getElementById('newPass').value = '';
        loadData();
    } else {
        alert("Error al crear usuario");
    }
  }

  async function createGroup() {
    const name = document.getElementById('groupName').value;
    if(!name) return alert("Escribe un nombre");
    
    const res = await fetch('/admin/create-group', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ name })
    });
    if(res.ok) {
        alert("Grupo creado");
        document.getElementById('groupName').value = '';
        loadData();
    } else {
        alert("Error al crear grupo");
    }
  }

  async function assignTeacherToGroup() {
    const tId = document.getElementById('assignTeacherSelect').value;
    const gId = document.getElementById('assignGroupSelect').value;
    if(!tId || !gId) return alert("Selecciona docente y grupo");

    const res = await fetch('/admin/assign-teacher', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ teacher_id: tId, group_id: gId })
    });
    
    if(res.ok) alert("Asignado correctamente");
    else alert("Error al asignar");
  }

  function toggleGroupSelect() {
    const role = document.getElementById('newRole').value;
    const groupSel = document.getElementById('userGroupSelect');
    if (role === 'alumno') {
      groupSel.disabled = false;
    } else {
      groupSel.disabled = true;
      groupSel.value = '';
    }
  }

  function logout() {
    localStorage.clear();
    window.location.href = '/login';
  }

  loadData();
</script>
</body>
</html>
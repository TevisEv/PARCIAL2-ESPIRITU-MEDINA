<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Mis Tareas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-white">
  <nav class="navbar navbar-dark bg-primary px-4">
    <span class="navbar-brand mb-0 h1">UNAS Tasks</span>
    <button onclick="logout()" class="btn btn-outline-light btn-sm">Cerrar Sesión</button>
  </nav>

  <div class="container mt-5">
    <h3>Mis Tareas</h3>
    
    <div class="input-group mb-4 mt-3">
      <input type="text" id="newTitle" class="form-control" placeholder="Nueva tarea...">
      <button class="btn btn-success" onclick="createTask()">Agregar</button>
    </div>

    <ul id="taskList" class="list-group">
      </ul>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) window.location.href = '/login';

    // 1. Cargar Tareas
    async function loadTasks() {
      const res = await fetch('/tasks', {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      if (!res.ok) {
        if (res.status === 401) logout();
        return;
      }
      const tasks = await res.json();
      const list = document.getElementById('taskList');
      list.innerHTML = '';
      
      tasks.forEach(task => {
        const li = document.createElement('li');
        li.className = `list-group-item d-flex justify-content-between align-items-center ${task.done ? 'list-group-item-success' : ''}`;
        li.innerHTML = `
          <span style="${task.done ? 'text-decoration: line-through;' : ''}">${task.title}</span>
          <div>
            <button onclick="deleteTask(${task.id})" class="btn btn-sm btn-danger">X</button>
          </div>
        `;
        list.appendChild(li);
      });
    }

    // 2. Crear Tarea
    async function createTask() {
      const title = document.getElementById('newTitle').value;
      if(!title) return;
      
      await fetch('/tasks', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token 
        },
        body: JSON.stringify({ title })
      });
      document.getElementById('newTitle').value = '';
      loadTasks();
    }

    // 3. Eliminar Tarea
    async function deleteTask(id) {
      await fetch(`/tasks/${id}`, {
        method: 'DELETE',
        headers: { 'Authorization': 'Bearer ' + token }
      });
      loadTasks();
    }

    function logout() {
      localStorage.removeItem('token');
      window.location.href = '/';
    }

    // Iniciar carga
    loadTasks();
  </script>
</body>
</html>
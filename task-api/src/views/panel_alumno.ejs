<!DOCTYPE html>
<html lang="es">
<head>
  <title>Alumno - UNAS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
  <div class="d-flex justify-content-between">
    <h2>Mis Tareas</h2>
    <button onclick="localStorage.clear(); window.location.href='/login'" class="btn btn-danger">Salir</button>
  </div>
  <hr>
  <ul id="taskList" class="list-group"></ul>

  <script>
    const token = localStorage.getItem('token');
    
    async function loadTasks() {
      const res = await fetch('/tasks', { headers: { 'Authorization': 'Bearer '+token } });
      if(!res.ok) window.location.href = '/login';
      
      const tasks = await res.json();
      const list = document.getElementById('taskList');
      list.innerHTML = '';
      
      if(tasks.length === 0) list.innerHTML = '<p class="text-muted">No tienes tareas pendientes.</p>';

      tasks.forEach(t => {
        list.innerHTML += `<li class="list-group-item">
          <h5>${t.title}</h5>
          <small class="text-muted">Asignado por: ${t.docente}</small>
        </li>`;
      });
    }
    loadTasks();
  </script>
</body>
</html>